<%# app/views/wishlists/index.html.erb %>
<div class="space-y-6">
  <h1 class="text-2xl font-bold text-slate-900">My Wishlist</h1>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @wishlist_series.each do |series| %>
      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between space-y-4">
        
        <%# Header: Title & Series Type Badge %>
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="text-xs font-semibold px-2.5 py-0.5 rounded bg-indigo-50 text-indigo-700 capitalize">
              <%= series.series_type&.humanize %>
            </span>
            <span class="text-xs text-slate-500">
              <%= series.books.count %> volumes
            </span>
          </div>
          <h3 class="text-lg font-bold text-slate-800 line-clamp-1"><%= series.title %></h3>
        </div>

        <%# Form controls for Priority and Status %>
        <%= form_with model: series, url: book_series_path(series), method: :patch, data: { controller: "auto-submit" }, class: "space-y-3 bg-slate-50 p-3 rounded-lg text-sm" do |f| %>
          
          <%# Priority Dropdown %>
          <div class="flex items-center justify-between">
            <%= f.label :wishlist_priority, "Priority:", class: "text-slate-600 font-medium" %>
            <%= f.select :wishlist_priority, 
                BookSeries.wishlist_priorities.keys.map { |k| [k.humanize, k] }, 
                {}, 
                onchange: "this.form.requestSubmit()",
                class: "text-xs rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 bg-white" %>
          </div>

          <%# Series Status Dropdown %>
          <div class="flex items-center justify-between">
            <%= f.label :series_status, "Status:", class: "text-slate-600 font-medium" %>
            <%= f.select :series_status, 
                BookSeries.series_statuses.keys.map { |k| [k.humanize, k] }, 
                {}, 
                onchange: "this.form.requestSubmit()",
                class: "text-xs rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 bg-white" %>
          </div>
        <% end %>

        <%# Actions (e.g. Move to Bookshelf or Delete) %>
        <div class="flex items-center justify-between pt-2 border-t border-slate-100">
          <%= button_to "Move to Bookshelf", book_series_path(series, book_series: { in_wishlist: false }), method: :patch, class: "text-xs font-semibold text-emerald-600 hover:text-emerald-700" %>
          <%= button_to "Remove", book_series_path(series), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "text-xs font-semibold text-rose-500 hover:text-rose-600" %>
        </div>

      </div>
    <% end %>
  </div>
</div>