<%# app/views/bookshelves/show_bookshelf.html.erb %>
<div class="h-[calc(100vh-57px)] flex flex-col overflow-hidden bg-slate-100"
     x-data="{ 
       seriesList: <%= @series_list.to_json(include: :books) %>,
       activeSeriesIndex: 0,
       get activeSeries() { return this.seriesList[this.activeSeriesIndex] || {} }
     }">

  <%# TOP 70% VERTICAL AREA: Detail Panel %>
  <div class="h-[70%] p-6 flex flex-col justify-between overflow-y-auto bg-white border-b border-slate-200">
    <template x-if="activeSeries.id">
      <div class="max-w-4xl mx-auto w-full grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
        
        <%# Cover Image %>
        <div class="w-full aspect-[2/3] max-w-[200px] mx-auto bg-slate-100 rounded-2xl overflow-hidden shadow-md">
          <img :src="activeSeries.cover_image_url" class="w-full h-full object-cover">
        </div>

        <%# Metadata & Controls (Takes 2 Columns) %>
        <div class="md:col-span-2 space-y-4">
          <div>
            <h2 class="text-2xl font-bold text-slate-900" x-text="activeSeries.title"></h2>
            <p class="text-sm text-slate-500" x-text="activeSeries.author"></p>
          </div>

          <%# Interactive Dropdown Form for Status, Genre, Tracking %>
          <%= form_with model: BookSeries.new, :html => { ":action" => "'/book_series/' + activeSeries.id + '/update_metadata'" }, method: :patch, class: "grid grid-cols-2 gap-3" do |f| %>
            <div>
              <label class="block text-xs font-semibold text-slate-500">Series Status</label>
              <select name="book_series[series_status]" class="mt-1 w-full text-xs font-semibold rounded-lg border-slate-200 p-2 bg-slate-50" x-model="activeSeries.series_status" @change="$el.form.submit()">
                <option value="ongoing">Ongoing</option>
                <option value="completed">Completed</option>
                <option value="unknown">Unknown</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-500">Genre</label>
              <select name="book_series[genre]" class="mt-1 w-full text-xs font-semibold rounded-lg border-slate-200 p-2 bg-slate-50" x-model="activeSeries.genre" @change="$el.form.submit()">
                <option value="shojo">Shojo</option>
                <option value="shonen">Shonen</option>
                <option value="bl">BL</option>
                <option value="light_novel">Light Novel</option>
                <option value="bunko">Bunko</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-500">Tracking Status</label>
              <select name="book_series[tracking_status]" class="mt-1 w-full text-xs font-semibold rounded-lg border-slate-200 p-2 bg-slate-50" x-model="activeSeries.tracking_status" @change="$el.form.submit()">
                <option value="actively_hunting">Actively Hunting</option>
                <option value="passive_watch">Passive Watch</option>
                <option value="on_standby">On Standby</option>
                <option value="someday">Someday</option>
                <option value="complete">Complete</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-500">Volume Overview</label>
              <div class="mt-1 text-sm font-bold text-indigo-600 bg-indigo-50 px-3 py-1.5 rounded-lg inline-block">
                <span x-text="activeSeries.books ? activeSeries.books.length : 0"></span> Volumes Collected
              </div>
            </div>
          <% end %>

          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a :href="'/search/series?' + new URLSearchParams({
                title: activeSeries.title,
                series_name: activeSeries.title,
                author: activeSeries.author || '',
                publisher: activeSeries.publication || '',
                rakuten_genre_id: activeSeries.rakuten_genre_id || ''
                }).toString()" 
            class="inline-flex items-center gap-1 text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 px-4 py-2 rounded-xl transition-colors">
            See More / Edit Volumes →
            </a>

            <%# Move back to Wishlist %>
            <form :action="'/book_series/' + activeSeries.id" method="post" class="inline">
              <input type="hidden" name="_method" value="patch">
              <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
              <input type="hidden" name="book_series[in_wishlist]" value="true">
              <button type="submit" class="text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 px-4 py-2 rounded-xl transition-colors">
                Move to Wishlist
              </button>
            </form>

            <%# Permanent Delete %>
            <form :action="'/book_series/' + activeSeries.id" method="post" class="inline"
                  @submit="if (!confirm('Are you sure you want to permanently delete ' + activeSeries.title + ' and all its volumes?')) { $event.preventDefault(); }">
              <input type="hidden" name="_method" value="delete">
              <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
              <button type="submit" class="text-xs font-bold text-red-600 bg-red-50 hover:bg-red-100 px-4 py-2 rounded-xl transition-colors">
                Delete Series
              </button>
            </form>
          </div>


        </div>
      </div>
    </template>
  </div>

  <%# BOTTOM 30% VERTICAL AREA: Horizontal Scroll Carousel %>
  <div class="h-[30%] bg-slate-900 p-4 flex items-center overflow-x-auto snap-x snap-mandatory scroll-smooth gap-6">
    <template x-for="(series, index) in seriesList" :key="series.id">
      <div @click="activeSeriesIndex = index"
           :class="activeSeriesIndex === index ? 'scale-110 ring-4 ring-indigo-500 opacity-100' : 'opacity-50 hover:opacity-80 scale-95'"
           class="snap-center shrink-0 w-24 aspect-[2/3] rounded-xl overflow-hidden cursor-pointer transition-all duration-300">
        <img :src="series.cover_image_url" class="w-full h-full object-cover">
      </div>
    </template>
  </div>

</div>