<%# app/views/bookshelves/show_bookshelf.html.erb %>
<div class="min-h-[calc(100vh-57px)] bg-slate-50/60 text-slate-800 relative overflow-x-hidden font-sans"
     x-data="{ 
       seriesList: <%= @series_list.to_json(include: :books) %>,
       activeSeriesIndex: 0,
       drawerOpen: false,
       get activeSeries() { return this.seriesList[this.activeSeriesIndex] || {} },
       selectSeries(index) {
         this.activeSeriesIndex = index;
         this.drawerOpen = true;
       }
     }">

  <%# Subtle Background Glow %>
  <template x-if="activeSeries.cover_image_url">
    <div class="fixed inset-0 pointer-events-none opacity-10 filter blur-3xl scale-125 transition-all duration-700 -z-0"
         :style="'background-image: url(' + activeSeries.cover_image_url + '); background-size: cover; background-position: center;'">
    </div>
  </template>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 relative z-10">
    
    <%# Top Header & Stats Bar %>
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 pb-6 border-b border-slate-200">
      <div>
        <h1 class="text-3xl font-black tracking-tight text-slate-900 flex items-center gap-3">
          <span>My Bookshelf</span>
          <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-600 border border-indigo-200/60" 
                x-text="seriesList.length + ' Series'">
          </span>
        </h1>
        <p class="text-xs text-slate-500 mt-1">Browse and manage your ongoing, completed, and tracked series.</p>
      </div>

      <%# Quick Stat Badge %>
      <div class="flex items-center gap-3">
        <div class="bg-white/80 backdrop-blur-md border border-slate-200 rounded-xl px-4 py-2 flex items-center gap-3 shadow-sm">
          <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
          <span class="text-xs text-slate-500 font-semibold">Total Volumes:</span>
          <span class="text-sm font-black text-indigo-600" x-text="seriesList.reduce((acc, s) => acc + (s.books ? s.books.length : 0), 0)"></span>
        </div>
      </div>
    </div>

    <%# Empty State %>
    <template x-if="seriesList.length === 0">
      <div class="text-center py-20 bg-white border border-slate-200/80 rounded-3xl shadow-sm">
        <span class="text-5xl">📚</span>
        <h3 class="text-lg font-bold text-slate-800 mt-3">Your Bookshelf is Empty</h3>
        <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">Start adding series from the search tab to track your collection.</p>
        <%= link_to "Search Series →", search_path, class: "mt-4 inline-block text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2.5 rounded-xl transition-all shadow-md shadow-indigo-600/10" %>
      </div>
    </template>

    <%# MAIN GRID DISPLAY %>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-5">
      <template x-for="(series, index) in seriesList" :key="series.id">
        <div @click="selectSeries(index)"
             :class="activeSeriesIndex === index && drawerOpen ? 'ring-2 ring-indigo-600 scale-[1.02] shadow-indigo-500/10 shadow-xl' : 'hover:scale-[1.02] hover:shadow-lg'"
             class="group relative bg-white rounded-2xl overflow-hidden border border-slate-200/80 cursor-pointer transition-all duration-300 flex flex-col justify-between shadow-sm">
          
          <%# Poster Image Frame %>
          <div class="aspect-[2/3] w-full bg-slate-100 overflow-hidden relative">
            <img :src="series.cover_image_url" 
                 :alt="series.title"
                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
            
            <%# Subtle Bottom Gradient %>
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent opacity-90"></div>

            <%# Top-Right Badge: Volume Count %>
            <div class="absolute top-2 right-2 bg-slate-900/80 backdrop-blur-md text-white text-[10px] font-bold px-2 py-0.5 rounded-lg shadow-sm border border-white/10">
              <span x-text="series.books ? series.books.length : 0"></span> Vol
            </div>

            <%# Bottom Overlay Info inside Card %>
            <div class="absolute bottom-2 left-2 right-2 space-y-0.5">
              <span class="inline-block text-[9px] uppercase tracking-wider font-black px-1.5 py-0.5 rounded bg-indigo-500/90 text-white"
                    x-text="series.series_status || 'Unknown'">
              </span>
              <h3 class="text-xs font-bold text-white leading-tight truncate" x-text="series.title"></h3>
              <p class="text-[10px] text-slate-300 truncate" x-text="series.author"></p>
            </div>
          </div>
        </div>
      </template>
    </div>
  </div>

  <%# SLIDE-OVER INSPECTOR DRAWER %>
  <div x-show="drawerOpen" 
       x-transition:enter="transition ease-out duration-300"
       x-transition:enter-start="opacity-0"
       x-transition:enter-end="opacity-100"
       x-transition:leave="transition ease-in duration-200"
       x-transition:leave-start="opacity-100"
       x-transition:leave-end="opacity-0"
       class="fixed inset-0 z-50 overflow-hidden bg-slate-900/40 backdrop-blur-xs flex justify-end"
       style="display: none;">

    <%# Backdrop click to close %>
    <div class="absolute inset-0" @click="drawerOpen = false"></div>

    <%# Drawer Panel %>
    <div x-show="drawerOpen"
         x-transition:enter="transition ease-out duration-300 transform"
         x-transition:enter-start="translate-x-full"
         x-transition:enter-end="translate-x-0"
         x-transition:leave="transition ease-in duration-200 transform"
         x-transition:leave-start="translate-x-0"
         x-transition:leave-end="translate-x-full"
         class="relative w-full max-w-md bg-white border-l border-slate-200 shadow-2xl h-full flex flex-col justify-between overflow-y-auto p-6 z-10">

      <template x-if="activeSeries.id">
        <div class="space-y-6">
          
          <%# Drawer Header %>
          <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">Series Details</span>
            <button @click="drawerOpen = false" type="button" class="text-slate-400 hover:text-slate-700 p-1 rounded-lg hover:bg-slate-100 transition-colors">
              ✕
            </button>
          </div>

          <%# Main Hero Visual & Info %>
          <div class="flex gap-4 items-start">
            <div class="w-24 aspect-[2/3] shrink-0 bg-slate-100 rounded-xl overflow-hidden shadow-md border border-slate-200/60">
              <img :src="activeSeries.cover_image_url" class="w-full h-full object-cover">
            </div>
            <div class="space-y-1 flex-1">
              <h2 class="text-lg font-bold text-slate-900 leading-snug" x-text="activeSeries.title"></h2>
              <p class="text-xs font-medium text-slate-500" x-text="'By ' + (activeSeries.author || 'Unknown Author')"></p>
              
              <div class="pt-2 flex flex-wrap gap-1.5">
                <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-slate-100 text-slate-600 border border-slate-200/60" x-text="activeSeries.publication || 'Publisher N/A'"></span>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-indigo-50 text-indigo-700 border border-indigo-100" x-text="(activeSeries.books ? activeSeries.books.length : 0) + ' Volumes Collected'"></span>
              </div>
            </div>
          </div>

          <%# Interactive Form Metadata Modifiers %>
          <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200/60 space-y-3">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Series Settings</h4>
            
            <form :action="'/book_series/' + activeSeries.id + '/update_metadata'" method="post" class="space-y-3" data-turbo="false">
              <input type="hidden" name="_method" value="patch">
              <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Series Status</label>
                <select name="book_series[series_status]" 
                        class="w-full text-xs font-semibold rounded-xl border border-slate-200 p-2.5 bg-white text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:outline-none cursor-pointer shadow-xs" 
                        x-model="activeSeries.series_status" 
                        @change="$el.form.submit()">
                  <option value="ongoing">Ongoing</option>
                  <option value="completed">Completed</option>
                  <option value="unknown">Unknown</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Genre</label>
                <select name="book_series[genre]" 
                        class="w-full text-xs font-semibold rounded-xl border border-slate-200 p-2.5 bg-white text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:outline-none cursor-pointer shadow-xs" 
                        x-model="activeSeries.genre" 
                        @change="$el.form.submit()">
                  <option value="shojo">Shojo</option>
                  <option value="shonen">Shonen</option>
                  <option value="bl">BL</option>
                  <option value="light_novel">Light Novel</option>
                  <option value="bunko">Bunko</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Tracking Status</label>
                <select name="book_series[tracking_status]" 
                        class="w-full text-xs font-semibold rounded-xl border border-slate-200 p-2.5 bg-white text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:outline-none cursor-pointer shadow-xs" 
                        x-model="activeSeries.tracking_status" 
                        @change="$el.form.submit()">
                  <option value="actively_hunting">Actively Hunting</option>
                  <option value="passive_watch">Passive Watch</option>
                  <option value="on_standby">On Standby</option>
                  <option value="someday">Someday</option>
                  <option value="complete">Complete</option>
                </select>
              </div>
            </form>
          </div>

          <%# Actions Section %>
          <div class="space-y-2 pt-2">
            <a :href="'/search/series?' + new URLSearchParams({
                title: activeSeries.title,
                series_name: activeSeries.title,
                author: activeSeries.author || '',
                publisher: activeSeries.publication || '',
                rakuten_genre_id: activeSeries.rakuten_genre_id || ''
                }).toString()" 
               class="w-full flex items-center justify-center gap-2 text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 px-4 py-3 rounded-xl transition-all shadow-md shadow-indigo-600/10">
              <span>See More / Edit Volumes</span>
              <span>→</span>
            </a>

            <div class="grid grid-cols-2 gap-2 pt-1">
              <%# Move back to Wishlist %>
              <form :action="'/book_series/' + activeSeries.id" method="post" class="w-full">
                <input type="hidden" name="_method" value="patch">
                <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
                <input type="hidden" name="book_series[in_wishlist]" value="true">
                <button type="submit" class="w-full text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 px-3 py-2.5 rounded-xl transition-colors border border-slate-200/60">
                  ★ Wishlist
                </button>
              </form>

              <%# Permanent Delete %>
              <form :action="'/book_series/' + activeSeries.id" method="post" class="w-full"
                    @submit="if (!confirm('Are you sure you want to permanently delete ' + activeSeries.title + ' and all its volumes?')) { $event.preventDefault(); }">
                <input type="hidden" name="_method" value="delete">
                <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
                <button type="submit" class="w-full text-xs font-bold text-rose-600 bg-rose-50 hover:bg-rose-100 border border-rose-200/60 px-3 py-2.5 rounded-xl transition-colors">
                  ✕ Delete
                </button>
              </form>
            </div>
          </div>

        </div>
      </template>
    </div>
  </div>

</div>