<div id="<%= dom_id book_series %>">
  <div>
    <strong>Title:</strong>
    <%= book_series.title %>
  </div>

  <div>
    <strong>Author:</strong>
    <%= book_series.author %>
  </div>

  <div>
    <strong>Publication:</strong>
    <%= book_series.publication %>
  </div>

  <div>
    <strong>Series status:</strong>
    <%= book_series.series_status %>
  </div>

  <div>
    <strong>Series type:</strong>
    <%= book_series.series_type %>
  </div>

  <div>
    <strong>Series genre:</strong>
    <%= book_series.series_genre %>
  </div>

  <div>
    <strong>Tracking status:</strong>
    <%= book_series.tracking_status %>
  </div>

</div>
