<%= form_with(model: book) do |form| %>
  <% if book.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(book.errors.count, "error") %> prohibited this book from being saved:</h2>

      <ul>
        <% book.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :book_series_id, style: "display: block" %>
    <%= form.text_field :book_series_id %>
  </div>

  <div>
    <%= form.label :volume_num, style: "display: block" %>
    <%= form.number_field :volume_num %>
  </div>

  <div>
    <%= form.label :volume_title, style: "display: block" %>
    <%= form.text_field :volume_title %>
  </div>

  <div>
    <%= form.label :isbn, style: "display: block" %>
    <%= form.text_field :isbn %>
  </div>

  <div>
    <%= form.label :cost, style: "display: block" %>
    <%= form.text_field :cost %>
  </div>

  <div>
    <%= form.label :book_status, style: "display: block" %>
    <%= form.number_field :book_status %>
  </div>

  <div>
    <%= form.label :image_url, style: "display: block" %>
    <%= form.text_field :image_url %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
