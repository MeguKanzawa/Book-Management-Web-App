<div id="<%= dom_id book %>">
  <div>
    <strong>Book series:</strong>
    <%= book.book_series_id %>
  </div>

  <div>
    <strong>Volume num:</strong>
    <%= book.volume_num %>
  </div>

  <div>
    <strong>Volume title:</strong>
    <%= book.volume_title %>
  </div>

  <div>
    <strong>Isbn:</strong>
    <%= book.isbn %>
  </div>

  <div>
    <strong>Cost:</strong>
    <%= book.cost %>
  </div>

  <div>
    <strong>Book status:</strong>
    <%= book.book_status %>
  </div>

  <div>
    <strong>Image url:</strong>
    <%= book.image_url %>
  </div>

</div>
