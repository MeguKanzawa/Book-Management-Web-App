<%# app/views/search/index.html.erb %>
<div class="min-h-screen bg-slate-50 pb-12">
  
  <%# Sticky Search Header %>
  <div class="sticky top-0 z-50 bg-white border-b border-slate-200 px-4 py-3 shadow-sm">
    <div class="max-w-md mx-auto">
      <h1 class="text-xl font-bold text-slate-800 mb-2 flex items-center gap-2">
        📚 <span>BookShelf Tracker</span>
      </h1>
      
      <%= form_with url: search_path, method: :get, local: true, class: "flex gap-2" do |f| %>
        <%= f.text_field :query, 
            value: params[:query], 
            placeholder: "Search Japanese manga or book title...", 
            class: "w-full px-4 py-3 bg-slate-100 border-0 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-indigo-500 focus:bg-white text-base transition-all",
            autofocus: true %>
        
        <%= f.submit "Search", 
            class: "bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-5 py-3 rounded-xl text-base active:scale-95 transition-transform cursor-pointer shadow-sm shadow-indigo-200" %>
      <% end %>
    </div>
  </div>

  <%# Search Results Area %>
  <div class="max-w-md mx-auto px-4 mt-4">
    <% if @found_series_by_genre.present? %>
      
      <div class="mb-3 flex items-center justify-between">
        <span class="text-xs font-bold text-slate-500">
          Found <%= @found_series_by_genre.size %> Series
        </span>
      </div>

      <div class="space-y-3">
        <% @found_series_by_genre.values.each do |series| %>
          <% s_title     = series[:title] || series["title"] %>
          <% s_name      = series[:series_name] || series["series_name"] %>
          <% s_author    = series[:author] || series["author"] %>
          <% s_publisher = series[:publisher] || series["publisher"] %>
          <% s_img       = series[:image_url] || series["image_url"] %>
          <% s_genre     = series[:rakuten_genre_id] || series["rakuten_genre_id"] %>

          <% existing_record = @existing_series_map[s_title] %>

          <div class="bg-white rounded-2xl p-3 shadow-sm border border-slate-100 flex gap-4 items-center">
            
            <%# Cover Image %>
            <div class="w-20 h-28 bg-slate-200 rounded-lg overflow-hidden flex-shrink-0 flex items-center justify-center text-center p-1">
              <% if s_img.present? %>
                <img src="<%= s_img %>" alt="<%= s_title %>" class="w-full h-full object-cover">
              <% else %>
                <span class="text-[10px] text-slate-400 font-medium">No Image</span>
              <% end %>
            </div>

            <%# Series Metadata & Actions %>
            <div class="flex-1 min-w-0 flex flex-col justify-between py-0.5">
              <h3 class="font-bold text-slate-900 text-base leading-tight line-clamp-2">
                <%= s_title %>
              </h3>
              
              <div class="mt-1">
                <% if s_author.present? %>
                  <p class="text-sm text-slate-600 font-medium truncate">
                    <%= s_author %>
                  </p>
                <% end %>
                
                <% if s_publisher.present? %>
                  <p class="text-xs text-slate-400 truncate mt-0.5">
                    <%= s_publisher %>
                  </p>
                <% end %>

                <% if s_genre.present? %>
                  <span class="inline-block mt-1 text-[10px] text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded font-semibold">
                    Genre: <%= s_genre %>
                  </span>
                <% end %>
              </div>

              <%# Action Buttons %>
              <div class="flex items-center gap-1 mt-3 pt-2 border-t border-slate-100 flex-wrap">
                <%= link_to "Select Series", 
                    search_series_path(
                      title: s_title,
                      series_name: s_name, 
                      rakuten_genre_id: s_genre, 
                      author: s_author, 
                      publisher: s_publisher,
                      query: params[:query]
                    ), 
                    class: "inline-flex items-center justify-center bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs px-3 py-2 rounded-lg transition-colors" %>

                <% if existing_record.present? %>
                <% if existing_record.in_wishlist? %>
                  <span class="inline-flex items-center text-xs font-bold text-amber-700 bg-amber-100 px-3 py-2 rounded-lg">
                    ⭐ In Wishlist
                  </span>
                <% else %>
                  <span class="inline-flex items-center text-xs font-bold text-emerald-700 bg-emerald-100 px-3 py-2 rounded-lg">
                    📚 In Bookshelf (<%= existing_record.books.count %> vol)
                  </span>
                <% end %>
                <% else %>
                  <%= form_with url: add_series_to_bookshelf_path, method: :post, class: "inline" do %>
                  <%= hidden_field_tag :title, s_title %>
                  <%= hidden_field_tag :author, s_author %>
                  <%= hidden_field_tag :publisher, s_publisher %>
                  <%= hidden_field_tag :rakuten_genre_id, s_genre%>
                  <%= hidden_field_tag :cover_image_url, s_img %>
                  <%= hidden_field_tag :series_type, :manga %>
                  <button type="submit" class="text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-2 rounded-lg transition-colors cursor-pointer">
                    + Bookshelf
                  </button>
                <% end %>

                <%= form_with url: add_series_to_wishlist_path, method: :post, class: "inline" do %>
                  <%= hidden_field_tag :title, s_title %>
                  <%= hidden_field_tag :author, s_author %>
                  <%= hidden_field_tag :publisher, s_publisher %>
                  <%= hidden_field_tag :rakuten_genre_id, s_genre%>
                  <%= hidden_field_tag :cover_image_url, s_img %>
                  <button type="submit" class="text-xs font-semibold bg-amber-50 hover:bg-amber-100 text-amber-600 px-3 py-2 rounded-lg transition-colors cursor-pointer">
                    ⭐ Wishlist
                  </button>
                <% end %>
                <% end %>

                
              </div>

            </div>

          </div>
        <% end %>
      </div>

    <% elsif params[:query].present? %>
      <%# No Results Found State %>
      <div class="text-center py-12">
        <p class="text-4xl mb-2">🔍</p>
        <h3 class="font-bold text-slate-700 text-lg">No books found</h3>
        <p class="text-slate-400 text-sm max-w-xs mx-auto mt-1">We couldn't find anything matching "<%= params[:query] %>".</p>
      </div>

    <% else %>
      <%# Initial Empty Search State %>
      <div class="text-center py-16 bg-white rounded-2xl border border-dashed border-slate-200 p-6 mt-4">
        <p class="text-4xl mb-3">📖</p>
        <h3 class="font-bold text-slate-800 text-lg">Your Personal Bookshelf</h3>
        <p class="text-slate-500 text-sm max-w-xs mx-auto mt-1">Search an ongoing manga or novel title above to pull data directly from the API.</p>
      </div>
    <% end %>
  </div>

</div>