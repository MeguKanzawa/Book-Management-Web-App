<%# app/views/search/show_series.html.erb %>
<div class="max-w-5xl mx-auto pb-16 font-sans text-slate-800"
     x-data="{ 
       selectedVolumes: [],
       targetStatus: 'owned',
       allVolumes: <%= (@volumes || []).to_json %>,
       showNotification: false,
       notificationMsg: '',

       // Robust identifier helper using ISBN first, then volume number, then title
       getVolKey(v) {
         if (!v) return '';
         const isbn = v.isbn || v['isbn'];
         if (isbn && isbn.length > 0) return isbn.toString();
         
         const volNum = v.volume_number || v['volume_number'];
         if (volNum !== undefined && volNum !== null && volNum !== '' && parseInt(volNum) > 0) {
           return volNum.toString();
         }
         
         return (v.title || v['title'] || '').toString();
       },

       selectAll() {
         this.selectedVolumes = this.allVolumes
           .filter(v => !v.owned && !v.status && !v.book_status)
           .map(v => this.getVolKey(v));
       },
       deselectAll() {
         this.selectedVolumes = [];
       },
       toggleVolume(volKey) {
         if (!volKey) return;
         const strKey = volKey.toString();
         if (this.selectedVolumes.includes(strKey)) {
           this.selectedVolumes = this.selectedVolumes.filter(id => id !== strKey);
         } else {
           this.selectedVolumes.push(strKey);
         }
       },
       triggerToast(msg) {
         this.notificationMsg = msg;
         this.showNotification = true;
         setTimeout(() => { this.showNotification = false; }, 3500);
       }
     }">

  <%# Notification Toast %>
  <div x-show="showNotification" 
       x-transition:enter="transition ease-out duration-300 transform"
       x-transition:enter-start="opacity-0 translate-y-[-20px]"
       x-transition:enter-end="opacity-100 translate-y-0"
       x-transition:leave="transition ease-in duration-200 transform"
       x-transition:leave-start="opacity-100 translate-y-0"
       x-transition:leave-end="opacity-0 translate-y-[-20px]"
       class="fixed top-20 right-4 z-50 bg-slate-900 text-white text-xs font-semibold px-4 py-3 rounded-xl shadow-xl flex items-center gap-2 border border-slate-700"
       style="display: none;">
    <span class="text-emerald-400 text-base">✓</span>
    <span x-text="notificationMsg"></span>
  </div>

  <%# DOCKED SUB-TOOLBAR %>
  <div class="sticky top-16 z-40 bg-slate-50/90 backdrop-blur-md border-b border-slate-200/80 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 py-3 mb-6 transition-all">
    <div class="max-w-5xl mx-auto flex items-center justify-between gap-2">
      <%= link_to search_path(query: @query), class: "text-xs font-bold text-slate-600 hover:text-indigo-600 transition-colors flex items-center gap-1.5 bg-white px-3 py-1.5 rounded-lg border border-slate-200/80 shadow-xs" do %>
        <span>← Back to Search</span>
      <% end %>
      
      <div class="flex items-center gap-2">
        <button @click="selectedVolumes.length > 0 ? deselectAll() : selectAll()" 
                type="button"
                class="text-xs font-semibold px-3 py-1.5 bg-white hover:bg-slate-100 text-slate-700 rounded-lg transition-colors border border-slate-200/80 shadow-xs">
          <span x-text="selectedVolumes.length > 0 ? 'Deselect All' : 'Select Uncollected'"></span>
        </button>

        <%= form_with url: add_volumes_book_series_path(@series_id.presence || 0), method: :post, class: "flex items-center gap-1.5", data: { turbo: false }, "@submit" => "triggerToast('Adding ' + selectedVolumes.length + ' volumes...')" do |f| %>
          <%= hidden_field_tag :title, @title %>
          <%= hidden_field_tag :author, @author %>
          <%= hidden_field_tag :publisher, @publisher %>
          <%= hidden_field_tag :rakuten_genre_id, @rakuten_genre_id %>
          <%= hidden_field_tag :query, @query %>

          <input type="hidden" name="book_status" :value="targetStatus">

          <%# Selected volumes template generator %>
          <template x-for="vol in allVolumes.filter(v => selectedVolumes.includes(getVolKey(v)))" :key="getVolKey(vol)">
            <div>
              <input type="hidden" name="selected_volumes[][volume_number]" :value="vol.volume_number || vol['volume_number'] || ''">
              <input type="hidden" name="selected_volumes[][title]" :value="vol.title || vol['title'] || ''">
              <input type="hidden" name="selected_volumes[][subtitle]" :value="vol.subtitle || vol['subtitle'] || ''">
              <input type="hidden" name="selected_volumes[][isbn]" :value="vol.isbn || vol['isbn'] || ''">
              <input type="hidden" name="selected_volumes[][image_url]" :value="vol.image_url || vol['image_url'] || ''">
              <input type="hidden" name="selected_volumes[][release_date]" :value="vol.release_date || vol['release_date'] || ''">
            </div>
          </template>

          <button type="submit" 
                  :disabled="selectedVolumes.length === 0" 
                  :class="selectedVolumes.length > 0 ? 'bg-indigo-600 hover:bg-indigo-700 text-white shadow-xs' : 'bg-slate-200 text-slate-400 cursor-not-allowed'" 
                  class="text-xs font-bold px-3.5 py-1.5 rounded-lg transition-all cursor-pointer">
            Add (<span x-text="selectedVolumes.length"></span>)
          </button>
        <% end %>
      </div>
    </div>
  </div>

  
  <%# HERO SERIES HEADER %>
  <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs mb-6">
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
      
      <%# Main Title & Metadata Section %>
      <div class="space-y-3 flex-1 min-w-0">
        <%# Badges & Quick Stats Row %>
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-[10px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-indigo-50 text-indigo-600 border border-indigo-100/80">
            Series Overview
          </span>

          <span class="text-[10px] font-extrabold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200/60">
            <%= @volumes.to_a.size %> <%= 'Volume'.pluralize(@volumes.to_a.size) %>
          </span>

          <% if @series_record.present? %>
            <% if @series_record.in_wishlist? %>
              <span class="inline-flex items-center gap-1 text-[10px] font-bold text-amber-700 bg-amber-50 border border-amber-200/80 px-2.5 py-0.5 rounded-full">
                ★ Wishlist
              </span>
            <% else %>
              <span class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200/80 px-2.5 py-0.5 rounded-full">
                ✓ On Shelf
              </span>
            <% end %>
          <% end %>
        </div>

        <%# Title & Author / Publisher Inline Bar %>
        <div>
          <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight leading-tight">
            <%= @title.presence || @series_name %>
          </h1>

          <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500 pt-1.5 font-medium">
            <% if @author.present? %>
              <div>
                <span class="text-slate-400 font-semibold">Author:</span>
                <span class="text-slate-700 font-bold"><%= @author %></span>
              </div>
            <% end %>
            <% if @author.present? && @publisher.present? %>
              <span class="text-slate-300">•</span>
            <% end %>
            <% if @publisher.present? %>
              <div>
                <span class="text-slate-400 font-semibold">Publisher:</span>
                <span class="text-slate-700 font-bold"><%= @publisher %></span>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <%# Compact Integrated Action Controls %>
      <div class="shrink-0 pt-1 md:pt-0">
        <% if @series_record.blank? %>
          <%# Series not in database -> Compact Button Group %>
          <div class="inline-flex items-center p-1 bg-slate-50 border border-slate-200/80 rounded-xl gap-1 shadow-2xs">
            
            <%= form_with url: add_series_to_bookshelf_path, method: :post, data: { turbo: false }, class: "inline-block" do %>
              <%= hidden_field_tag :title, @title %>
              <%= hidden_field_tag :author, @author %>
              <%= hidden_field_tag :publisher, @publisher %>
              <%= hidden_field_tag :rakuten_genre_id, @rakuten_genre_id %>
              <%= hidden_field_tag :cover_image_url, @cover_image_url %>
              <%= hidden_field_tag :query, @query %>
              <%= hidden_field_tag :series_type, :manga %>
              <%= hidden_field_tag :in_wishlist, true %>
              <button type="submit" 
                      title="Add Series to Wishlist"
                      class="text-xs font-bold text-amber-900 bg-amber-50 hover:bg-amber-100 border border-amber-200/80 px-3 py-1.5 rounded-lg transition-all active:scale-[0.98] cursor-pointer flex items-center gap-1">
                <span class="text-amber-600">★</span>
                <span>Wishlist</span>
              </button>
            <% end %>

            <%= form_with url: add_series_to_bookshelf_path, method: :post, data: { turbo: false }, class: "inline-block" do %>
              <%= hidden_field_tag :title, @title %>
              <%= hidden_field_tag :author, @author %>
              <%= hidden_field_tag :publisher, @publisher %>
              <%= hidden_field_tag :rakuten_genre_id, @rakuten_genre_id %>
              <%= hidden_field_tag :cover_image_url, @cover_image_url %>
              <%= hidden_field_tag :query, @query %>
              <%= hidden_field_tag :series_type, :manga %>
              <%= hidden_field_tag :in_wishlist, false %>
              <button type="submit" 
                      class="text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 border border-indigo-700/30 px-3.5 py-1.5 rounded-lg transition-all active:scale-[0.98] shadow-2xs cursor-pointer flex items-center gap-1">
                <span>+ Add to Shelf</span>
              </button>
            <% end %>

          </div>

        <% elsif @series_record.in_wishlist? %>
          <%# Series in Wishlist -> Move to Shelf Button %>
          <%= form_with url: book_series_path(@series_record), method: :patch, data: { turbo: false } do %>
            <%= hidden_field_tag "book_series[in_wishlist]", false %>
            <button type="submit" 
                    class="text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 border border-emerald-700/30 px-3.5 py-2 rounded-xl transition-all active:scale-[0.98] shadow-2xs cursor-pointer flex items-center gap-1.5">
              <span>+ Move Series to Shelf</span>
            </button>
          <% end %>

        <% end %>
      </div>

    </div>
  </div>

  <%# Volumes Grid %>
  <% if @volumes.present? %>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
      <% @volumes.each do |volume| %>
        <% vol_title    = volume[:title] || volume["title"] %>
        <% vol_img      = volume[:image_url] || volume["image_url"] %>
        <% vol_num      = (volume[:volume_number] || volume["volume_number"]) %>
        <% vol_num_i    = vol_num.to_i %>
        <% vol_date     = volume[:release_date] || volume["release_date"] %>
        <% vol_id       = volume[:id] || volume["id"] %>
        <% vol_isbn     = volume[:isbn] || volume["isbn"] %>
        <% vol_subtitle = volume[:subtitle] || volume["subtitle"] %>
        
        <%# Fallback chain for JavaScript Keying %>
        <% vol_key = vol_isbn.presence || (vol_num_i ? "vol_#{vol_num_i}" : vol_title) %>

        <%# Find matching existing book from DB series %>
        <% existing_book = if @series_record.present? && @series_record.books.loaded?
                      @series_record.books.find do |b|
                        # 1. Match by ISBN (Most reliable)
                        (vol_isbn.present? && b.isbn.to_s.strip == vol_isbn.to_s.strip) ||
                        
                        # 2. Match by Volume Number (ONLY if greater than 0)
                        (vol_num_i > 0 && b.volume_num.to_i == vol_num_i) ||
                        
                        # 3. Match by Volume Title (ONLY if present and non-empty)
                        (vol_title.present? && b.volume_title.to_s.strip.downcase == vol_title.to_s.strip.downcase)
                      end
                    end %>

        <% raw_status = existing_book&.book_status %>
        <% vol_status = raw_status.present? ? raw_status.to_s.downcase.to_sym : nil %>
        <% is_in_bookshelf = existing_book.present? && vol_status.present? %>
        <% vol_id = existing_book&.id %>
        
        <div class="rounded-2xl border border-slate-200/80 bg-white p-2.5 flex flex-col justify-between transition-all duration-200 group relative shadow-xs"
             <% unless is_in_bookshelf %>
               @click="toggleVolume('<%= j vol_key %>')"
               :class="selectedVolumes.includes('<%= j vol_key %>') ? 'ring-2 ring-indigo-600 border-indigo-600 bg-indigo-50/20 shadow-md' : 'hover:shadow-md cursor-pointer'"
             <% end %>>

          <div class="w-full aspect-[2/3] bg-slate-100 rounded-xl overflow-hidden mb-2.5 relative flex items-center justify-center border border-slate-100">
            <% if vol_img.present? %>
              <img src="<%= vol_img %>" alt="<%= vol_title %>" class="w-full h-full object-cover <%= 'group-hover:scale-105' unless is_in_bookshelf %> transition-transform duration-300">
            <% else %>
              <div class="w-full h-full flex flex-col items-center justify-center text-slate-400 p-4 text-center bg-slate-50">
                <span class="text-xs font-medium">No Image</span>
              </div>
            <% end %>

            <% if is_in_bookshelf %>
              <% case vol_status %>
              <% when :owned %>
                <div class="absolute top-2 right-2 bg-emerald-600 text-white text-[10px] font-bold px-2 py-0.5 rounded-md shadow-sm">✓ Owned</div>
              <% when :wishlist %>
                <div class="absolute top-2 right-2 bg-amber-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-md shadow-sm">★ Wishlist</div>
              <% when :ignored %>
                <div class="absolute top-2 right-2 bg-slate-600 text-white text-[10px] font-bold px-2 py-0.5 rounded-md shadow-sm">✕ Ignored</div>
              <% when :sold %>
                <div class="absolute top-2 right-2 bg-rose-600 text-white text-[10px] font-bold px-2 py-0.5 rounded-md shadow-sm">$ Sold</div>
              <% else %>
                <div class="absolute top-2 right-2 bg-emerald-600 text-white text-[10px] font-bold px-2 py-0.5 rounded-md shadow-sm">✓ Collected</div>
              <% end %>
            <% else %>
              <div class="absolute top-2 right-2 w-6 h-6 rounded-lg flex items-center justify-center text-xs font-bold shadow-sm transition-all duration-200"
                   :class="selectedVolumes.includes('<%= j vol_key %>') ? 'bg-indigo-600 text-white scale-100' : 'bg-white/90 text-transparent scale-90'">
                ✓
              </div>
            <% end %>
          </div>

          <div class="flex flex-col justify-between flex-grow space-y-1.5">
            <div class="flex items-center justify-between gap-1">
              <% if vol_num_i > 0 %>
                <span class="bg-indigo-50 text-indigo-700 border border-indigo-100/80 font-extrabold text-[10px] px-2 py-0.5 rounded inline-block shrink-0">
                  VOL <%= vol_num_i %>
                </span>
              <% elsif vol_subtitle.present? %>
                <span class="bg-violet-50 text-violet-700 border border-violet-100/80 font-extrabold text-[10px] px-2 py-0.5 rounded inline-block shrink-0">
                  STORY
                </span>
              <% else %>
                <span class="bg-slate-100 text-slate-600 font-medium text-[10px] px-2 py-0.5 rounded inline-block shrink-0">
                  SPECIAL
                </span>
              <% end %>

              <% if vol_isbn.present? %>
                <span class="hidden sm:inline-block text-[10px] font-mono font-medium text-slate-400 truncate max-w-[105px]" title="ISBN: <%= vol_isbn %>">
                  <%= vol_isbn %>
                </span>
              <% end %>
            </div>

            <h4 class="text-xs font-bold text-slate-800 line-clamp-2 leading-tight" title="<%= vol_title %>">
              <%= vol_title %>
            </h4>

            <% if is_in_bookshelf && vol_id.present? %>
              <div class="pt-2 border-t border-slate-100 mt-auto" @click.stop>
                <%= form_with model: Book.new, url: book_path(vol_id), method: :patch, data: {turbo: false}, class: "w-full" do |f| %>
                  <%= hidden_field_tag :redirect_to_series, true %>
                  <%= hidden_field_tag :title, @title %>
                  <%= hidden_field_tag :author, @author %>
                  <%= hidden_field_tag :publisher, @publisher %>
                  <%= hidden_field_tag :rakuten_genre_id, @rakuten_genre_id %>
                  <%= hidden_field_tag :query, @query %>
                  <input type="hidden" name="selected_volumes[][volume_number]" value="<%= vol_num %>">
                  <input type="hidden" name="selected_volumes[][title]" value="<%= vol_title %>">
                  <input type="hidden" name="selected_volumes[][image_url]" value="<%= vol_img %>">

                  <select name="book[book_status]" 
                          onchange="this.form.submit()" 
                          class="w-full text-[11px] font-semibold border border-slate-200 rounded-lg px-2 py-1 bg-slate-50 text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer">
                    <option value="owned" <%= 'selected' if vol_status.to_s == 'owned' %>>Owned</option>
                    <option value="wishlist" <%= 'selected' if vol_status.to_s == 'wishlist' %>>Wishlist</option>
                    <option value="ignored" <%= 'selected' if vol_status.to_s == 'ignored' %>>Ignored</option>
                    <option value="sold" <%= 'selected' if vol_status.to_s == 'sold' %>>Sold</option>
                  </select>
                <% end %>
              </div>
            <% end %>

          </div>

        </div>
      <% end %>
    </div>
  <% end %>

</div>