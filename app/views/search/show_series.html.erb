<%# app/views/search/show_series.html.erb %>
<div class="min-h-screen bg-slate-50 pb-12">

  <%# Header with Back Navigation %>
  <div class="sticky top-0 z-50 bg-white border-b border-slate-200 px-4 py-3 shadow-sm">
    <div class="max-w-4xl mx-auto flex items-center justify-between">
      <%= link_to "← Back to Search", search_path(query: @query), class: "text-sm font-semibold text-indigo-600 hover:text-indigo-800 transition-colors flex items-center gap-1" %>
      <span class="text-xs font-medium text-slate-500 bg-slate-100 px-3 py-1 rounded-full">
        <%= @volumes.to_a.size %> Volumes Found
      </span>
    </div>
  </div>

  <%# Series Overview Header %>
  <div class="max-w-4xl mx-auto px-4 mt-6">
    <div class="bg-white rounded-2xl p-2 border border-slate-100 shadow-sm mb-6">
      <h1 class="text-2xl font-bold text-slate-900 leading-snug">
        <%= @title.presence || @series_name %>
      </h1>
      <div class="mt-2 text-xs text-slate-500 flex flex-col flex-wrap gap-x-4 gap-y-1">
        <% if @author.present? %>
          <p><span class="font-semibold text-slate-700">Author:</span> <%= @author %></p>
        <% end %>
        <% if @publisher.present? %>
          <p><span class="font-semibold text-slate-700">Publisher:</span> <%= @publisher %></p>
        <% end %>
        <% if @genre_id.present? %>
          <p><span class="font-semibold text-slate-700">Genre ID:</span> <%= @genre_id %></p>
        <% end %>
      </div>
    </div>

    <%# Volumes Grid - Clean 3 Column Layout %>
    <% if @volumes.present? %>
      <div class="grid grid-cols-3 gap-4 mt-2">
        <% @volumes.each do |volume| %>
          <%# Safe Key Extraction for both String & Symbol keys %>
          <% vol_title  = volume[:title] || volume["title"] %>
          <% vol_img    = volume[:image_url] || volume["image_url"] %>
          <% vol_num    = (volume[:volume_number] || volume["volume_number"]).to_i %>
          <% vol_date   = volume[:release_date] || volume["release_date"] %>
          <% vol_id     = volume[:id] || volume["id"] %>

          <div class="bg-white rounded-2xl border border-slate-200 p-2 flex flex-col justify-between shadow-sm hover:shadow-md transition-all duration-200 group">
            
            <%# Cover Image Frame %>
            <div class="w-full aspect-[2/3] bg-slate-100 rounded-xl overflow-hidden mb-3 relative flex items-center justify-center border border-slate-100 p-2">
              <% if vol_img.present? %>
                <img src="<%= vol_img %>" alt="<%= vol_title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
              <% else %>
                <div class="w-full h-full flex flex-col items-center justify-center text-slate-400 p-4 text-center bg-slate-50">
                  <span class="text-2xl mb-1">📖</span>
                  <span class="text-xs font-medium">No Cover Image</span>
                </div>
              <% end %>
            </div>

            <%# Volume Specifics Section (Below Cover inside the Tile) %>
            <div class="flex flex-col justify-between flex-grow pt-1 space-y-2">
              
              <%# Volume Number Badge & Meta Tag %>
              <div class="flex items-center justify-between gap-2">
                <% if vol_num > 0 %>
                  <span class="bg-indigo-50 text-indigo-600 border-indigo-100 font-bold text-xs px-2.5 py-0.5 rounded-md inline-block">
                    Vol <%= vol_num %>
                  </span>
                <% else %>
                  <span class="bg-slate-100 text-slate-600 font-medium text-xs px-2 py-0.5 rounded-md inline-block">
                    Special / Side Story
                  </span>
                <% end %>

                <% if vol_id.present? %>
                  <span class="text-[10px] font-mono text-slate-400 truncate max-w-[100px]" title="ID: <%= vol_id %>">
                    #<%= vol_id.to_s.last(8) %>
                  </span>
                <% end %>
              </div>

              <%# Volume Full Title %>
              <h4 class="text-sm font-bold text-slate-800 line-clamp-2 leading-snug" title="<%= vol_title %>">
                <%= vol_title %>
              </h4>

              <%# Specific Metadata Details Block %>
              <div class="pt-2 border-t border-slate-100 mt-auto text-xs text-slate-500 space-y-1">
                <% if vol_date.present? %>
                  <div class="flex items-center justify-between text-[11px]">
                    <span class="text-slate-400 font-medium">Release Date:</span>
                    <span class="font-semibold text-slate-700"><%= vol_date %></span>
                  </div>
                <% end %>
              </div>

            </div>
          </div>
        <% end %>
      </div>

    <% else %>
      <div class="text-center py-12 bg-white rounded-2xl border border-slate-100 p-6">
        <p class="text-3xl mb-2">📦</p>
        <h3 class="font-bold text-slate-700 text-base">No volumes found</h3>
        <p class="text-slate-400 text-xs max-w-xs mx-auto mt-1">
          Unable to fetch volumes for this series from the Rakuten API.
        </p>
      </div>
    <% end %>
  </div>

</div>