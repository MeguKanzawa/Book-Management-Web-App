<%# app/views/search/show_series.html.erb %>
<div class="min-h-screen bg-slate-50 pb-16"
     x-data="{ 
       selectedVolumes: [],
       allVolumes: <%= (@volumes || []).to_json %>,
       showNotification: false,
       notificationMsg: '',

       // Filter out already owned volumes when running selectAll
       selectAll() {
         this.selectedVolumes = this.allVolumes
           .filter(v => !(v.owned || v['owned']))
           .map(v => (v.volume_number || v['volume_number'] || '').toString());
       },
       deselectAll() {
         this.selectedVolumes = [];
       },
       toggleVolume(volNum, isOwned) {
         if (isOwned) return; // Prevent selection of already collected volumes
         const strVol = volNum.toString();
         if (this.selectedVolumes.includes(strVol)) {
           this.selectedVolumes = this.selectedVolumes.filter(id => id !== strVol);
         } else {
           this.selectedVolumes.push(strVol);
         }
       },
       triggerToast(msg) {
         this.notificationMsg = msg;
         this.showNotification = true;
         setTimeout(() => { this.showNotification = false; }, 3500);
       }
     }">

  <%# Notification Indicator Toast %>
  <div x-show="showNotification" 
       x-transition:enter="transition ease-out duration-300 transform"
       x-transition:enter-start="opacity-0 translate-y-[-20px]"
       x-transition:enter-end="opacity-100 translate-y-0"
       x-transition:leave="transition ease-in duration-200 transform"
       x-transition:leave-start="opacity-100 translate-y-0"
       x-transition:leave-end="opacity-0 translate-y-[-20px]"
       class="fixed top-16 right-4 z-50 bg-slate-900 text-white text-xs font-semibold px-4 py-3 rounded-xl shadow-xl flex items-center gap-2 border border-slate-700"
       style="display: none;">
    <span class="text-emerald-400 text-base">✓</span>
    <span x-text="notificationMsg"></span>
  </div>

  <%# Header with Back Navigation & Selection Controls %>
  <div class="sticky top-0 z-50 bg-white border-b border-slate-200 px-4 py-3 shadow-sm">
    <div class="max-w-4xl mx-auto flex items-center justify-between gap-2">
      <%= link_to "← Back to Search", search_path(query: @query), class: "text-sm font-semibold text-indigo-600 hover:text-indigo-800 transition-colors flex items-center gap-1" %>
      
      <div class="flex items-center gap-2">
        <button @click="selectedVolumes.length === allVolumes.filter(v => !(v.owned || v['owned'])).length ? deselectAll() : selectAll()" 
                type="button"
                class="text-xs font-semibold px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg transition-colors cursor-pointer">
          <span x-text="selectedVolumes.length === allVolumes.filter(v => !(v.owned || v['owned'])).length && selectedVolumes.length > 0 ? 'Deselect All' : 'Select Uncollected'"></span>
        </button>

        <%= form_with url: add_volumes_book_series_path(@series_id || 0), method: :post, class: "inline", "@submit" => "triggerToast('Adding ' + selectedVolumes.length + ' volumes to Bookshelf...')" do |f| %>
          <template x-for="vol in allVolumes.filter(v => selectedVolumes.includes((v.volume_number || v['volume_number'] || '').toString()))" :key="vol.volume_number || vol['volume_number']">
            <div>
              <input type="hidden" name="selected_volumes[][volume_number]" :value="vol.volume_number || vol['volume_number']">
              <input type="hidden" name="selected_volumes[][title]" :value="vol.title || vol['title']">
              <input type="hidden" name="selected_volumes[][image_url]" :value="vol.image_url || vol['image_url']">
              <input type="hidden" name="selected_volumes[][release_date]" :value="vol.release_date || vol['release_date']">
            </div>
          </template>
          
          <button type="submit" 
                  :disabled="selectedVolumes.length === 0" 
                  :class="selectedVolumes.length > 0 ? 'bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm' : 'bg-slate-200 text-slate-400 cursor-not-allowed'" 
                  class="text-xs font-bold px-3 py-2 rounded-lg transition-all cursor-pointer">
            Add (<span x-text="selectedVolumes.length"></span>)
          </button>
        <% end %>
      </div>
    </div>
  </div>

  <%# Series Overview Header %>
  <div class="max-w-4xl mx-auto px-4 mt-6">
    <div class="bg-white rounded-2xl p-4 border border-slate-100 shadow-sm mb-6 flex items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-slate-900 leading-snug">
          <%= @title.presence || @series_name %>
        </h1>
        <div class="mt-2 text-xs text-slate-500 flex flex-wrap gap-x-4 gap-y-1">
          <% if @author.present? %>
            <p><span class="font-semibold text-slate-700">Author:</span> <%= @author %></p>
          <% end %>
          <% if @publisher.present? %>
            <p><span class="font-semibold text-slate-700">Publisher:</span> <%= @publisher %></p>
          <% end %>
          <% if @rakuten_genre_id.present? %>
            <p><span class="font-semibold text-slate-700">Genre ID:</span> <%= @rakuten_genre_id %></p>
          <% end %>
        </div>
      </div>

      <span class="text-xs font-medium text-slate-500 bg-slate-100 px-3 py-1 rounded-full shrink-0">
        <%= @volumes.to_a.size %> Volumes Found
      </span>
    </div>

    <%# Volumes Grid %>
    <% if @volumes.present? %>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mt-2">
        <% @volumes.each do |volume| %>
          <% vol_title  = volume[:title] || volume["title"] %>
          <% vol_img    = volume[:image_url] || volume["image_url"] %>
          <% vol_num    = (volume[:volume_number] || volume["volume_number"]).to_i %>
          <% vol_owned  = volume[:owned] || volume["owned"] %>

          <div @click="toggleVolume(<%= vol_num %>, <%= vol_owned ? 'true' : 'false' %>)"
               :class="{
                 'border-emerald-200 bg-emerald-50/40 opacity-90 cursor-default': <%= vol_owned ? 'true' : 'false' %>,
                 'ring-2 ring-indigo-600 border-indigo-600 bg-indigo-50/20 shadow-md cursor-pointer': !<%= vol_owned ? 'true' : 'false' %> && selectedVolumes.includes('<%= vol_num %>'),
                 'border-slate-200 bg-white shadow-sm hover:shadow-md cursor-pointer': !<%= vol_owned ? 'true' : 'false' %> && !selectedVolumes.includes('<%= vol_num %>')
               }"
               class="rounded-2xl border p-3 flex flex-col justify-between transition-all duration-200 group relative">
            
            <%# Cover Image Frame %>
            <div class="w-full aspect-[2/3] bg-slate-100 rounded-xl overflow-hidden mb-3 relative flex items-center justify-center border border-slate-100">
              <% if vol_img.present? %>
                <img src="<%= vol_img %>" alt="<%= vol_title %>" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105">
              <% else %>
                <div class="w-full h-full flex flex-col items-center justify-center text-slate-400 p-4 text-center bg-slate-50">
                  <span class="text-2xl mb-1">📖</span>
                  <span class="text-xs font-medium">No Image</span>
                </div>
              <% end %>

              <%# Collected Badge vs Selection Badge Overlay %>
              <% if vol_owned %>
                <div class="absolute top-2 right-2 bg-emerald-600 text-white text-[10px] font-bold px-2 py-1 rounded-md shadow-md flex items-center gap-1">
                  ✓ Collected
                </div>
              <% else %>
                <div class="absolute top-2 right-2 w-6 h-6 rounded-md flex items-center justify-center text-xs font-bold shadow-md transition-all duration-200"
                     :class="selectedVolumes.includes('<%= vol_num %>') ? 'bg-indigo-600 text-white scale-100' : 'bg-white/80 text-transparent scale-90'">
                  ✓
                </div>
              <% end %>
            </div>

            <%# Volume Info %>
            <div class="flex flex-col justify-between flex-grow space-y-2">
              <div class="flex items-center justify-between gap-2">
                <% if vol_num > 0 %>
                  <span class="bg-indigo-50 text-indigo-600 border border-indigo-100 font-bold text-xs px-2.5 py-1 rounded inline-block">
                    VOL <%= vol_num %>
                  </span>
                <% else %>
                  <span class="bg-slate-100 text-slate-600 font-medium text-[10px] px-1.5 py-0.5 rounded-md inline-block">
                    Special / Side
                  </span>
                <% end %>

                <% if vol_owned %>
                  <span class="text-[10px] font-semibold text-emerald-600">In Library</span>
                <% end %>
              </div>

              <h4 class="text-sm font-bold text-slate-800 line-clamp-2 leading-snug" title="<%= vol_title %>">
                <%= vol_title %>
              </h4>
            </div>

          </div>
        <% end %>
      </div>

    <% else %>
      <div class="text-center py-12 bg-white rounded-2xl border border-slate-100 p-6">
        <p class="text-3xl mb-2">📦</p>
        <h3 class="font-bold text-slate-700 text-base">No volumes found</h3>
        <p class="text-slate-400 text-xs max-w-xs mx-auto mt-1">
          Unable to fetch volumes for this series from the Rakuten API.
        </p>
      </div>
    <% end %>
  </div>

</div>